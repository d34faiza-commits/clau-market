{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "facts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_key": {
            "type": "string",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "value": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "fact_key",
          "label",
          "value",
          "source"
        ]
      }
    }
  },
  "required": [
    "facts"
  ],
  "$defs": {
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "fact_sheet",
            "voice_card",
            "brief",
            "campaign",
            "asset",
            "approved_content",
            "tool_result"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted"
          ]
        }
      },
      "required": [
        "client_code",
        "source_type",
        "source_id",
        "source_version",
        "content_sha256",
        "retrieved_at",
        "sensitivity"
      ]
    }
  }
}
